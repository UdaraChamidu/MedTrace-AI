# Public values may be shared with the browser only when RLS is enabled.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Server-side/n8n only. Never expose or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
OPENAI_API_KEY=

# Configurable model routing.
OPENAI_CLASSIFICATION_MODEL=gpt-5.6-luna
OPENAI_EXTRACTION_MODEL=gpt-5.6-terra
OPENAI_EXPLANATION_MODEL=gpt-5.6-terra
OPENAI_VERIFICATION_MODEL=gpt-5.6
OPENAI_QA_MODEL=gpt-5.6-terra
OPENAI_QA_ESCALATION_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
N8N_WEBHOOK_BASE_URL=https://YOUR_N8N_HOST/webhook
ALLOWED_FRONTEND_ORIGIN=http://localhost:5173
