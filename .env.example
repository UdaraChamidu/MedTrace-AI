# Frontend mode: "demo" works without any external service.
VITE_DATA_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_N8N_BASE_URL=

# Server-side only. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
OPENAI_API_KEY=
N8N_WEBHOOK_SECRET=

# Configurable model routing
OPENAI_MODEL_CLASSIFICATION=gpt-5.6-luna
OPENAI_MODEL_EXTRACTION=gpt-5.6-terra
OPENAI_MODEL_EXPLANATION=gpt-5.6-terra
OPENAI_MODEL_VERIFICATION=gpt-5.6
OPENAI_MODEL_QA=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

